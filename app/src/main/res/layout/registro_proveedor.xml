<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_registro">


    <ScrollView
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="¡Registra un proveedor!"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nombre:"
                android:textColor="@android:color/white" />
            <EditText
                android:id="@+id/edit_nombre_registro_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:inputType="textPersonName"
                android:textColor="@android:color/white" />

            <!-- Apellido Paterno -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Apellido paterno:"
                android:textColor="@android:color/white" />
            <EditText
                android:id="@+id/edit_apellido_p_registro_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:inputType="textPersonName"
                android:textColor="@android:color/white" />

            <!-- Apellido Materno -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Apellido materno:"
                android:textColor="@android:color/white" />
            <EditText
                android:id="@+id/edit_apellido_m_registro_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:inputType="textPersonName"
                android:textColor="@android:color/white" />

            <!-- Correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Correo:"
                android:textColor="@android:color/white" />
            <EditText
                android:id="@+id/edittext_regiistro_proveedor_correo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:inputType="textEmailAddress"
                android:textColor="@android:color/white" />

            <!-- Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Contraseña:"
                android:textColor="@android:color/white" />
            <EditText
                android:id="@+id/edittext_regiistro_proveedor_contraseña"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:inputType="textPassword"
                android:textColor="@android:color/white" />

            <!-- Repite Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Repite la contraseña:"
                android:textColor="@android:color/white" />
            <EditText
                android:id="@+id/edittext_regiistro_proveedor_repite_contraseña"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:inputType="textPassword"
                android:textColor="@android:color/white" />

            <!-- Teléfono -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Teléfono:"
                android:textColor="@android:color/white" />
            <EditText
                android:id="@+id/edittext_regiistro_proveedor_telefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:inputType="phone"
                android:textColor="@android:color/white" />

            <!-- Descripción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Descripción:"
                android:textColor="@android:color/white" />
            <EditText
                android:id="@+id/edittext_regiistro_proveedor_descripcion"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:backgroundTint="@android:color/white"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textColor="@android:color/white" />

            <!-- Categoría (Desplegable) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Categoría:"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spinner_registro_proveedor_categoria"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@android:color/white" />

            <!-- Servicios (Dinámico con Checkboxes) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Servicios:"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/container_servicios_checkboxes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">
                <!-- Los CheckBoxes se añadirán aquí programáticamente -->
            </LinearLayout>

            <Button
                android:id="@+id/button_regiistro_proveedor_registrarme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@android:color/white"
                android:text="Registrarme"
                android:textColor="#0D2E6E" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="bottom"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FIXLY"
            android:textColor="#0D2E6E"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>