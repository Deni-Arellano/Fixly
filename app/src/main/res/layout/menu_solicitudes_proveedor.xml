<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">


    <include layout="@layout/header"/>


    <TextView
        android:id="@+id/texto_titulo_mis_solicitudes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:paddingHorizontal="24dp"
        android:text="Mis solicitudes"
        android:textAlignment="textStart"
        android:textColor="@color/azul_medio_fixly"
        android:textSize="28sp"
        android:textStyle="bold" />

    <include layout="@layout/item_solicitud"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_mis_solicitudes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <include layout="@layout/bottom_nav_proveedor"/>

</LinearLayout>