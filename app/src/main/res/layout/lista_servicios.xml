<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f7fa">


    <include layout="@layout/header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Necesitas servicio de plomería?"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#00296b"
                android:layout_marginBottom="20dp"/>

            <ImageButton
                android:id="@+id/plomero1"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_plomero"
                android:scaleType="fitXY"
                android:src="@drawable/plomero1"/>

            <ImageButton
                android:id="@+id/plomero2"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_plomero"
                android:scaleType="fitXY"
                android:src="@drawable/plomero2"/>

            <ImageButton
                android:id="@+id/plomero3"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/card_plomero"
                android:scaleType="fitXY"
                android:src="@drawable/plomero3"/>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />

</LinearLayout>