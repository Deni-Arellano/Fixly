<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_principal_cambiar_contrasena"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <include layout="@layout/header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenedor_contenido_cambiar_contrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="Cambiar contraseña"
                android:textAlignment="textStart"
                android:textColor="@color/azul_medio_fixly"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Contraseña Actual -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Contraseña actual:"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_contrasena_actual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/azul_fixly"
                android:inputType="textPassword"
                android:textColor="@android:color/black" />

            <!-- Nueva Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nueva contraseña:"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_nueva_contrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/azul_fixly"
                android:inputType="textPassword"
                android:textColor="@android:color/black" />

            <!-- Confirmar Nueva Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Confirmar nueva contraseña:"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_confirmar_contrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/azul_fixly"
                android:inputType="textPassword"
                android:textColor="@android:color/black" />

            <!-- BLOQUE DE ADVERTENCIA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@color/gris_fondo"
                android:orientation="horizontal"
                android:padding="16dp"
                android:weightSum="1"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.30"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:srcCompat="@android:drawable/stat_sys_warning"
                    app:tint="@color/amarillo_fixly" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.70"
                    android:paddingStart="12dp"
                    android:text="La nueva contraseña debe tener al menos 8 caracteres, incluir mayúsculas, minúsculas, un número y un símbolo especial"
                    android:textColor="@color/azul_medio_fixly"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- BOTONES -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_ver_item_solicitud"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="48dp"
                android:backgroundTint="@color/amarillo_fixly"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Guardar"
                android:textAllCaps="false"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                app:cornerRadius="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_cancelar_cambio_cambiar_contrasena"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                app:cornerRadius="4dp"
                app:strokeColor="@color/gris_texto"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />

</LinearLayout>