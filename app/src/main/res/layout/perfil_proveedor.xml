<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f7fa">

    <include layout="@layout/header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/borde_foto"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/foto_perfil"
                    android:scaleType="centerCrop"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Martin Orozco Ramirez"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#00296b"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plomero"
                android:textSize="18sp"
                android:textColor="#00296b"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="789 102 96 74"
                android:textSize="18sp"
                android:textColor="#00296b"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oliveres #89"
                android:textSize="18sp"
                android:textColor="#00296b"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="La solución a su plomeria"
                android:textSize="14sp"
                android:textColor="#00296b"
                android:layout_marginTop="6dp"/>

            <Button
                android:id="@+id/btnVerMas"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Solicitar servicio"
                android:textAllCaps="false"
                android:textColor="#00296b"
                android:textStyle="bold"
                android:backgroundTint="#fdc500"
                android:layout_marginTop="20dp"/>

            <RatingBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:rating="4"
                android:stepSize="1"
                android:isIndicator="true"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comentarios"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#00296b"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffffff"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:text="Juan Perez"
                    android:textStyle="bold"
                    android:textColor="#00296b"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Excelente servicio, muy rápido y profesional."
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffffff"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:text="Maria Lopez"
                    android:textStyle="bold"
                    android:textColor="#00296b"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Me arregló una fuga en minutos. Muy recomendado."
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_nav" />

</LinearLayout>