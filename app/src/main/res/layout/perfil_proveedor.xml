<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_fondo">

    <include layout="@layout/header"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedor_contenido_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- FOTO -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/fondo_imagen_redondeada"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imagen_proveedor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/imagen_redondeada"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_usuario_placeholder"/>
            </FrameLayout>

            <!-- NOMBRE -->
            <TextView
                android:id="@+id/texto_nombre_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre Apellido"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/azul_fixly"
                android:gravity="center"
                android:layout_marginTop="12dp"/>

            <!-- TELEFONO -->
            <TextView
                android:id="@+id/texto_telefono_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="999 123 45 67"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

            <!-- DESCRIPCION -->
            <TextView
                android:id="@+id/texto_descripcion_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción..."
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

            <!-- SERVICIOS -->
            <TextView
                android:id="@+id/titulo_servicios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servicios"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/texto_servicios_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Servicios..."
                android:textColor="@color/black"
                android:layout_marginTop="4dp"/>

            <!-- BOTON -->
            <Button
                android:id="@+id/boton_solicitar_servicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicitar servicio"
                android:backgroundTint="@color/amarillo_fixly"
                android:textColor="@color/azul_fixly"
                android:layout_marginTop="16dp"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valoración"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginTop="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@android:color/white"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/texto_promedio_estrellas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <RatingBar
                        android:id="@+id/rating_bar"
                        style="?android:attr/ratingBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="0"
                        android:stepSize="0.1"
                        android:isIndicator="true"
                        android:progressTint="@color/amarillo_fixly"
                        android:secondaryProgressTint="@android:color/transparent"
                        android:backgroundTint="@android:color/transparent" />

                    <TextView
                        android:id="@+id/texto_total_comentarios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0 comentarios)"
                        android:textSize="14sp"
                        android:textColor="@color/gris_texto"/>
                </LinearLayout>

            </LinearLayout>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comentarios"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_comentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_nav"/>

</LinearLayout>
