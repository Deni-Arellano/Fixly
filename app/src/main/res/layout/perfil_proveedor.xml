<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_fondo">

    <include layout="@layout/header"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedor_contenido_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- FOTO -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/fondo_imagen_redondeada"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imagen_proveedor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/imagen_redondeada"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_usuario_placeholder"/>
            </FrameLayout>

            <!-- NOMBRE -->
            <TextView
                android:id="@+id/texto_nombre_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre Apellido"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/azul_fixly"
                android:gravity="center"
                android:layout_marginTop="12dp"/>

            <!-- TELEFONO -->
            <TextView
                android:id="@+id/texto_telefono_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="999 123 45 67"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

            <!-- DESCRIPCION -->
            <TextView
                android:id="@+id/texto_descripcion_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción..."
                android:gravity="center"
                android:layout_marginTop="8dp"/>

            <!-- RATING -->
            <RatingBar
                android:id="@+id/rating_proveedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.5"
                android:isIndicator="true"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"/>

            <!-- SERVICIOS -->
            <TextView
                android:id="@+id/titulo_servicios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servicios"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/texto_servicios_proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Servicios..."
                android:layout_marginTop="4dp"/>

            <!-- BOTON -->
            <Button
                android:id="@+id/boton_solicitar_servicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicitar servicio"
                android:backgroundTint="@color/amarillo_fixly"
                android:textColor="@color/azul_fixly"
                android:layout_marginTop="16dp"/>

            <!-- COMENTARIOS -->
            <TextView
                android:id="@+id/titulo_comentarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comentarios"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/texto_sin_comentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no hay comentarios"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_comentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/bottom_nav"/>

</LinearLayout>