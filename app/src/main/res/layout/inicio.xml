<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_fondo">

    <!-- Menú superior (logo, salir) -->
    <include layout="@layout/header" />

    <!-- Contenido principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Hola Fani!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué servicio necesitas hoy?"
                android:textColor="@color/gris_texto"
                android:layout_marginBottom="20dp"/>

            <!-- Servicios -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false"
                android:layout_marginBottom="12dp">

                <!-- 1. Plomería -->
                <LinearLayout
                    android:id="@+id/boton_plomeria_inicio"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Plomería"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/ic_serv_plomeria" />
                </LinearLayout>

                <!-- 2. Electricidad -->
                <LinearLayout
                    android:id="@+id/boton_electricidad_inicio"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Electricidad"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/ic_serv_electricidad" />
                </LinearLayout>

                <!-- 3. Jardinería -->
                <LinearLayout
                    android:id="@+id/boton_jardineria_inicio"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Jardinería"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/ic_serv_jardineria" />
                </LinearLayout>

                <!-- 4. Limpieza -->
                <LinearLayout
                    android:id="@+id/boton_limpieza_inicio"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Limpieza"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/ic_serv_limpieza" />
                </LinearLayout>

                <!-- 5. Pintura -->
                <LinearLayout
                    android:id="@+id/boton_pintura_inicio"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Pintura"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/ic_serv_pintura" />
                </LinearLayout>

                <!-- 6. Cerrajería -->
                <LinearLayout
                    android:id="@+id/boton_cerrajeria_inicio"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Cerrajería"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/ic_serv_cerrajeria" />
                </LinearLayout>

                <!-- 7. Mecánica -->
                <LinearLayout
                    android:id="@+id/boton_mecanica_inicio"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Mecánica"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/ic_serv_mecanica" />
                </LinearLayout>

                <!-- 8. Instalación de equipos -->
                <LinearLayout
                    android:id="@+id/boton_instalacion_inicio"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Instalación"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/ic_serv_instalacion" />
                </LinearLayout>

            </GridLayout>
        </LinearLayout>

    </ScrollView>

    <!-- barra inferior (historial, home, mi perfil) -->
    <include layout="@layout/bottom_nav" />

</LinearLayout>