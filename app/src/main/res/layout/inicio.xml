<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gris_fondo">

    <!-- Menú superior (logo, salir) -->
    <include layout="@layout/header" />

    <!-- Contenido principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Hola Fani!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué servicio necesitas hoy?"
                android:textColor="@color/gris_texto"
                android:layout_marginBottom="20dp"/>

            <!-- Servicios -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false"
                android:layout_marginBottom="12dp">

                <!-- plomería -->
                <LinearLayout
                    android:id="@+id/boton_inicio_plomeria"
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Plomería"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/plome" />
                </LinearLayout>

                <!-- electricidad -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Electricidad"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/electric" />
                </LinearLayout>

                <!-- cerrajería -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Cerrajería"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/cerraje" />
                </LinearLayout>

                <!-- mecánica -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:background="@android:color/white"
                    android:elevation="3dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="1"
                        android:text="Mecánica"
                        android:textColor="@color/azul_fixly"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="top"
                        android:src="@drawable/mecanic" />
                </LinearLayout>

            </GridLayout>

            <Button
                android:id="@+id/btnVerMas"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ver más servicios"
                android:textAllCaps="false"
                android:textColor="@color/azul_fixly"
                android:textStyle="bold"
                android:backgroundTint="@color/amarillo_fixly"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profesionales destacados"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/containerDestacados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitudes"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/containerSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

    </ScrollView>

    <!-- barra inferior (historial, home, mi perfil) -->
    <include layout="@layout/bottom_nav" />

</LinearLayout>