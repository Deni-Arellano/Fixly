<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">


    <include layout="@layout/header"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layout_contenido_solicitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitar servicio"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginBottom="15dp"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calle"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/input_calle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0D3B66"
                android:layout_marginBottom="12dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No. exterior"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/input_numero_exterior"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#0D3B66"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No. interior"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <EditText
                        android:id="@+id/input_numero_interior"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#0D3B66"/>
                </LinearLayout>

            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colonia"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/input_colonia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0D3B66"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ciudad"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/input_ciudad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0D3B66"
                android:layout_marginBottom="20dp"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona un servicio"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginBottom="10dp"/>

            <RadioGroup
                android:id="@+id/grupo_servicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- Ejemplos de servicios -->
                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reparación de fugas"/>

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Instalación de tubería"/>

            </RadioGroup>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción del servicio"
                android:textStyle="bold"
                android:textColor="@color/azul_fixly"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/input_descripcion_servicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#0D3B66"
                android:layout_marginBottom="30dp"/>

            <Button
                android:id="@+id/boton_solicitar_servicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicitar"
                android:backgroundTint="@color/amarillo_fixly"
                android:textColor="@color/azul_fixly"
                android:textStyle="bold"/>


            <Button
                android:id="@+id/boton_cancelar_servicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:backgroundTint="#E0E0E0"
                android:textColor="@color/azul_fixly"/>

        </LinearLayout>

    </ScrollView>


    <include layout="@layout/bottom_nav"/>

</LinearLayout>