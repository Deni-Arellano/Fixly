<?xml version="1.0" encoding="utf-8"?>
<!-- las tarjetitas que se usan para mostrar cada proveedor en la lista de proveedores -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_proveedor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:padding="12dp"
    android:orientation="horizontal"
    android:background="@android:color/white"
    android:elevation="2dp"

    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">



    <!-- foto del proveedor -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/fondo_imagen_redondeada"
        android:padding="4dp">

        <ImageView
            android:id="@+id/imagen_proveedor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/imagen_redondeada"
            android:clipToOutline="true"
            android:src="@drawable/ic_usuario_placeholder"/>

    </FrameLayout>

    <!-- contenedor de datos  -->
    <LinearLayout
        android:id="@+id/contenedor_datos_proveedor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- nombre -->
        <TextView
            android:id="@+id/texto_nombre_proveedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Apellido Apellido"
            android:textColor="@color/azul_fixly"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <!-- descripcion -->
        <TextView
            android:id="@+id/texto_descripcion_proveedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción del servicio que ofrece el proveedor..."
            android:textColor="@color/gris_texto"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</LinearLayout>