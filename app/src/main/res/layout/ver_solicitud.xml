<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_principal_ver_solicitud"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fondo"
    android:orientation="vertical">

    <include layout="@layout/header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Solicitud"
                android:textColor="@color/azul_fixly"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- SECCIÓN PRESTADOR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Prestador"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/fondo_imagen_redondeada"
                        android:padding="3dp">

                        <ImageView
                            android:id="@+id/imagen_prestador_ver_solicitud"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/imagen_redondeada"
                            android:clipToOutline="true"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_usuario_placeholder" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/texto_nombre_prestador_ver_solicitud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sin asignar"
                            android:textColor="@color/azul_fixly"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_call"
                                app:tint="@color/azul_fixly" />

                            <TextView
                                android:id="@+id/texto_telefono_prestador_ver_solicitud"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="000 000 0000"
                                android:textColor="@android:color/black"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DIRECCIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/direccion_ver_solicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Morelos #5, Tuitán, Estado de México. 57400"
                android:textColor="@android:color/black" />

            <!-- REFERENCIA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Referencia"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/referencia_ver_solicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Casa de 2 pisos"
                android:textColor="@android:color/black" />

            <!-- DESCRIPCIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/descripcion_ver_solicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Reparación de fugas del lavabo del baño"
                android:textColor="@android:color/black" />

            <!-- ESTADO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/estado_ver_solicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Pendiente"
                android:textColor="@android:color/black" />

            <!-- TIPO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tipo_ver_solicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Reparación de fugas"
                android:textColor="@android:color/black" />

            <!-- SOLICITADO EL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitado el"
                android:textColor="@color/azul_fixly"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fecha_ver_solicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="18 de abril de 2026, 10:30 am"
                android:textColor="@android:color/black" />

            <!-- CONTENEDOR DE BOTONES DINÁMICOS -->
            <LinearLayout
                android:id="@+id/contenedor_botones_solicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- Botón Editar (Caso 1) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_editar_solicitud"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/amarillo_fixly"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Editar"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="0dp" />

                <!-- Botón Cancelar (Caso 1) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_cancelar_solicitud"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Cancelar solicitud"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="0dp"
                    app:strokeColor="@color/gris_texto"
                    app:strokeWidth="1dp" />

                <!-- Botón Calificar (Caso 2) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_calificar_proveedor"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/amarillo_fixly"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Calificar proveedor"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="0dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />

</LinearLayout>
